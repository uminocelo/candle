<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-feature
        android:name="android.software.leanback"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.touchscreen"
        android:required="false" />
    <!-- The multicast permission below implies Wi-Fi; Ethernet-only boxes work too. -->
    <uses-feature
        android:name="android.hardware.wifi"
        android:required="false" />

    <!-- Granted from Settings → Setup, or over adb (scripts/deploy.sh) where the device has no
         screen for it, like the HY300; it has no system file picker either. -->
    <uses-permission
        android:name="android.permission.MANAGE_EXTERNAL_STORAGE"
        tools:ignore="ScopedStorage" />

    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <!-- The DLNA player hears phones searching for renderers over SSDP multicast. -->
    <uses-permission android:name="android.permission.CHANGE_WIFI_MULTICAST_STATE" />
    <!-- SMB shares and the phone remote's server. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- The settings hub shows the projector's IP address. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Granted from Settings → Setup (or by scripts/deploy.sh): the phone remote's PIN overlay
         and its "home" command, which starts Candle from the background. -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />

    <!-- Both granted over adb by scripts/deploy.sh, for the settings hub's quick settings. -->
    <uses-permission
        android:name="android.permission.WRITE_SECURE_SETTINGS"
        tools:ignore="ProtectedPermissions" />
    <uses-permission
        android:name="android.permission.WRITE_SETTINGS"
        tools:ignore="ProtectedPermissions" />

    <!-- Android 11 package visibility: TV apps for the apps row, the HDMI input screen and settings screens. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
        </intent>
        <package android:name="com.softwinner.awsource" />
        <!-- Settings hub screens (settings/SystemScreens.kt). -->
        <package android:name="com.android.tv.settings" />
        <intent>
            <action android:name="android.settings.WIFI_SETTINGS" />
        </intent>
        <intent>
            <action android:name="android.settings.BLUETOOTH_SETTINGS" />
        </intent>
        <intent>
            <action android:name="action.htcsettings.bluetooth" />
        </intent>
        <intent>
            <action android:name="action.htcsettings.prjsettings" />
        </intent>
        <intent>
            <action android:name="android.settings.DATE_SETTINGS" />
        </intent>
        <intent>
            <action android:name="android.settings.INTERNAL_STORAGE_SETTINGS" />
        </intent>
        <intent>
            <action android:name="android.settings.MANAGE_APPLICATIONS_SETTINGS" />
        </intent>
        <intent>
            <action android:name="android.settings.SETTINGS" />
        </intent>
    </queries>

    <!-- Phones, DLNA servers and NAS boxes serve media over plain http on the home network. -->
    <application
        android:allowBackup="false"
        android:usesCleartextTraffic="true"
        android:banner="@drawable/banner"
        android:icon="@drawable/ic_candle"
        android:label="@string/app_name"
        android:theme="@android:style/Theme.DeviceDefault.NoActionBar">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:screenOrientation="landscape"
            android:stateNotNeeded="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
            <!-- Lets Candle be chosen as the home screen (scripts/home-candle.sh). -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <activity
            android:name=".settings.SettingsActivity"
            android:exported="false"
            android:screenOrientation="landscape" />

        <activity
            android:name=".settings.AboutActivity"
            android:exported="false"
            android:screenOrientation="landscape" />

        <activity
            android:name=".smb.NetworkActivity"
            android:exported="false"
            android:screenOrientation="landscape" />

        <activity
            android:name=".usb.UsbBrowserActivity"
            android:exported="false"
            android:screenOrientation="landscape" />

        <activity
            android:name=".viewer.PhotoViewerActivity"
            android:exported="false"
            android:screenOrientation="landscape"
            android:theme="@android:style/Theme.DeviceDefault.NoActionBar.Fullscreen" />

        <activity
            android:name=".viewer.PdfReaderActivity"
            android:exported="false"
            android:screenOrientation="landscape"
            android:theme="@android:style/Theme.DeviceDefault.NoActionBar.Fullscreen" />

        <!-- Exported with VIEW so adb and other apps (file managers) can open videos in Candle. -->
        <activity
            android:name=".player.VideoPlayerActivity"
            android:exported="true"
            android:screenOrientation="landscape"
            android:theme="@android:style/Theme.DeviceDefault.NoActionBar.Fullscreen">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="file" />
                <data android:scheme="content" />
                <data android:mimeType="video/*" />
            </intent-filter>
        </activity>

        <!-- Opening one song queues its whole folder, starting at that song. -->
        <activity
            android:name=".player.NowPlayingActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:screenOrientation="landscape">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="file" />
                <data android:mimeType="audio/*" />
            </intent-filter>
        </activity>

        <service
            android:name=".player.MusicService"
            android:exported="true"
            android:foregroundServiceType="mediaPlayback">
            <intent-filter>
                <action android:name="androidx.media3.session.MediaSessionService" />
            </intent-filter>
        </service>

        <!-- The HTTP server for the phone remote and the DLNA player (Settings → Phone remote). -->
        <service
            android:name=".remote.RemoteService"
            android:exported="false" />
    </application>
</manifest>
