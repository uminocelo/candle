<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:clipChildren="false"
    android:orientation="vertical"
    android:paddingStart="@dimen/screen_padding_horizontal"
    android:paddingTop="@dimen/screen_padding_vertical"
    android:paddingEnd="@dimen/screen_padding_horizontal"
    android:paddingBottom="@dimen/screen_padding_vertical">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/section_gap"
        android:text="@string/app_name"
        android:textColor="@color/flame"
        android:textSize="24sp"
        android:textStyle="bold" />

    <TextView
        style="@style/SectionTitle"
        android:text="@string/section_sources" />

    <HorizontalScrollView style="@style/TileRow">

        <LinearLayout
            android:id="@+id/sources_row"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:clipChildren="false"
            android:orientation="horizontal" />
    </HorizontalScrollView>

    <LinearLayout
        android:id="@+id/continue_section"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/section_gap"
        android:clipChildren="false"
        android:orientation="vertical"
        android:visibility="gone">

        <TextView
            style="@style/SectionTitle"
            android:text="@string/section_continue" />

        <HorizontalScrollView style="@style/TileRow">

            <LinearLayout
                android:id="@+id/continue_row"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:clipChildren="false"
                android:orientation="horizontal" />
        </HorizontalScrollView>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/apps_section"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/section_gap"
        android:clipChildren="false"
        android:orientation="vertical">

        <TextView
            style="@style/SectionTitle"
            android:text="@string/section_apps" />

        <HorizontalScrollView style="@style/TileRow">

            <LinearLayout
                android:id="@+id/apps_row"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:clipChildren="false"
                android:orientation="horizontal" />
        </HorizontalScrollView>
    </LinearLayout>
</LinearLayout>
