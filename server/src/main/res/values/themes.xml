<resources>
    <style name="Theme.Server" parent="@android:style/Theme.DeviceDefault.NoActionBar">
        <item name="android:windowBackground">@color/background</item>
        <item name="android:statusBarColor">@color/background</item>
        <item name="android:navigationBarColor">@color/background</item>
        <item name="android:colorAccent">@color/flame</item>
        <!-- One UI otherwise draws an "on" switch and ticked boxes in dark grey. -->
