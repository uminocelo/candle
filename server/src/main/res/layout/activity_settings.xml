<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/app_name"
            android:textColor="@color/flame"
            android:textSize="26sp"
            android:textStyle="bold" />

        <!-- What a fresh install still needs; hidden once everything is granted. -->
        <LinearLayout
            android:id="@+id/first_run"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/card"
            android:orientation="vertical"
            android:padding="16dp"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/first_run_title"
                android:textColor="@color/flame"
                android:textSize="18sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/files_access"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/files_access" />

            <TextView
                android:id="@+id/files_access_hint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/files_access_hint"
                android:textColor="@color/text_muted" />

            <Button
                android:id="@+id/battery"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/battery" />

            <TextView
                android:id="@+id/battery_hint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/battery_hint"
                android:textColor="@color/text_muted" />
        </LinearLayout>

        <Switch
            android:id="@+id/server_switch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:minHeight="48dp"
            android:text="@string/server_on"
            android:textSize="18sp" />

        <TextView
            android:id="@+id/address"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textIsSelectable="true"
            android:textSize="16sp" />

        <ImageView
            android:id="@+id/qr"
            android:layout_width="@dimen/qr"
            android:layout_height="@dimen/qr"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="16dp"
            android:contentDescription="@null" />

        <Switch
            android:id="@+id/players_switch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:minHeight="48dp"
            android:text="@string/players"
            android:textSize="18sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/players_hint"
            android:textColor="@color/text_muted" />

        <Switch
            android:id="@+id/private_switch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:minHeight="48dp"
            android:text="@string/private_mode"
            android:textSize="18sp" />

        <TextView
            android:id="@+id/private_hint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/text_muted" />

        <Button
            android:id="@+id/password"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp" />


        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:labelFor="@+id/name"
            android:text="@string/name_label"
            android:textColor="@color/text_muted" />

        <EditText
            android:id="@+id/name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:autofillHints=""
            android:imeOptions="actionDone"
            android:inputType="textCapWords"
            android:maxLength="40"
            android:minHeight="48dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/folders_title"
            android:textColor="@color/flame"
            android:textSize="18sp" />

        <LinearLayout
            android:id="@+id/folders"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

        <Button
            android:id="@+id/about"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/about" />
    </LinearLayout>
</ScrollView>
